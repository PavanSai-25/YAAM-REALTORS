# ─────────────────────────────────────────────────────────────────────────────
# Yaam Realtors — environment variables
# Copy to .env.local for development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemap, Open Graph, WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Business contact (defaults; admins can override in /admin/settings) ─────
# WhatsApp number with country code, digits only. Powers every "Chat on WhatsApp" button.
YAAM_WHATSAPP_NUMBER=917993983540
YAAM_PHONE="+91 79939 83540"
YAAM_EMAIL=

# ── Data backend ─────────────────────────────────────────────────────────────
# Leave the Supabase values empty to run the LOCAL demo backend (JSON file in
# .data/, uploads on disk). Set them to use Supabase (required on Vercel).
# DATA_BACKEND=local|supabase forces one explicitly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used ONLY to create staff/seller accounts from /admin/staff.
# Never prefix with NEXT_PUBLIC_. Optional.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-images

# ── Local demo backend only ──────────────────────────────────────────────────
# Admin account seeded on first run of the local backend.
LOCAL_ADMIN_EMAIL=admin@yaam.local
LOCAL_ADMIN_PASSWORD=change-me-before-demo
# 32+ random characters to sign local session cookies. If unset, one is
# generated into .data/.auth-secret on first run.
AUTH_SECRET=

# ── Maps (optional) ──────────────────────────────────────────────────────────
# Google Maps Embed API key. Without it, maps use OpenStreetMap (no key needed).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
